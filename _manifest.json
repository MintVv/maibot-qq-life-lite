{
  "manifest_version": 2,
  "id": "MintVv.maibot-qq-life-lite",
  "version": "1.0.0",
  "name": "白饭 QQ 生活轻扩展",
  "description": "趣图收藏、指定空间相册上传、说说草稿与低频自主发布、头像昵称提议。独立持久化、主人审批、结果核对。",
  "plugin_type": "creative",
  "author": {"name": "MintVv", "url": "https://github.com/MintVv"},
  "urls": {"repository": "https://github.com/MintVv/maibot-qq-life-lite"},
  "license": "MIT",
  "host_application": {"min_version": "1.3.17", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.19.0", "max_version": "2.29.99"},
  "dependencies": [
    {"type": "python_package", "name": "maibot-plugin-sdk", "version_spec": ">=2.19.0,<2.30"},
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28,<1"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2,<3"}
  ],
  "capabilities": ["api.call", "chat.get_all_streams", "chat.open_session", "message.get_recent", "message.get_by_id", "llm.generate", "send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
